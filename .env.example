# Names only. Copy to .env.local and fill in values. Never commit .env.local.
FASTROUTER_API_KEY=
FASTROUTER_BASE_URL=https://go.fastrouter.ai/api/v1
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_DEEP=anthropic/claude-sonnet-5.5
TAVILY_API_KEY=
STORE_DRIVER=fs
RATE_LIMIT_PER_HOUR=10
DAILY_GENERATION_CAP=100
AGENT_MAX_ACTIONS=7
AGENT_MAX_PAGE_READS=6
AGENT_MAX_SECONDS=55
PROBE_MAX_URLS=8
PROBE_TIMEOUT_MS=8000
PROBE_TRACE_MAX_HOPS=5
PROBE_TRACE_MAX_SECONDS=25
TRACE_LLM_CHOOSER=on
GATHER_MODE=agent
